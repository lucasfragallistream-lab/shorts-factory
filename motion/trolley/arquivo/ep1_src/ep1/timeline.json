 "atempo": 1.0187,
 "palavras_por_s": 3.36,
 "linhas": [
  {
   "id": "gancho",
   "quem": "narrador",
   "texto": "O freio deste trem acabou de quebrar. E o maquinista é você.",
   "a": 0.12,
   "b": 3.357,
   "w0": 0,
   "w1": 12
  },
  {
   "id": "serra",
   "quem": "narrador",
   "texto": "Cem toneladas de aço descendo a serra a oitenta por hora.",
   "a": 3.477,
   "b": 6.219,
   "w0": 12,
   "w1": 23
  },
  {
   "id": "freio",
   "quem": "narrador",
   "texto": "Você puxa o freio uma vez. Nada. Duas vezes. Nada. Na terceira, a alavanca solta na sua mão.",
   "a": 6.339,
   "b": 12.694,
   "w0": 23,
   "w1": 41
  },
  {
   "id": "divide",
   "quem": "narrador",
   "texto": "Lá na frente, o trilho se divide em dois.",
   "a": 12.814,
   "b": 15.176,
   "w0": 41,
   "w1": 50
  },
  {
   "id": "filhotes",
   "quem": "narrador",
   "texto": "No trilho A, cinco filhotes de golden presos numa caixa de papelão, latindo sem parar.",
   "a": 15.296,
   "b": 19.877,
   "w0": 50,
   "w1": 65
  },
  {
   "id": "helena",
   "quem": "narrador",
   "texto": "E do lado deles, a doutora Helena, com a única fórmula da cura do câncer no bolso do jaleco.",
   "a": 19.997,
   "b": 24.524,
   "w0": 65,
   "w1": 84
  },
  {
   "id": "cida",
   "quem": "narrador",
   "texto": "No trilho B, dona Cida, noventa e dois anos, tricotando o casaco do neto.",
   "a": 24.644,
   "b": 28.755,
   "w0": 84,
   "w1": 98
  },
  {
   "id": "socorro",
   "quem": "cida",
   "texto": "Meu Deus do céu, alguém me ajuda!",
   "a": 29.035,
   "b": 31.321,
   "w0": 98,
   "w1": 105
  },
  {
   "id": "panda",
   "quem": "narrador",
   "texto": "E abraçado nela, dormindo, o último panda do planeta.",
   "a": 31.601,
   "b": 34.687,
   "w0": 105,
   "w1": 114
  },
  {
   "id": "desvio",
   "quem": "narrador",
   "texto": "Só resta uma alavanca, a do desvio. Se você não fizer nada, o trem vai direto para o trilho A.",
   "a": 34.807,
   "b": 39.803,
   "w0": 114,
   "w1": 134
  },
  {
   "id": "ex",
   "quem": "narrador",
   "texto": "Aí a doutora Helena olha para a cabine, e você reconhece aquele rosto. É a sua ex. A mesma que te largou no altar.",
   "a": 39.923,
   "b": 45.935,
   "w0": 134,
   "w1": 158
  },
  {
   "id": "amor",
   "quem": "helena",
   "texto": "Oi, amor.",
   "a": 46.215,
   "b": 47.181,
   "w0": 158,
   "w1": 160
  },
  {
   "id": "pergunta",
   "quem": "narrador",
   "texto": "Trilho A, ou trilho B? Você tem dez segundos.",
   "a": 47.461,
   "b": 50.433,
   "w0": 160,
   "w1": 169
  }
 ],
