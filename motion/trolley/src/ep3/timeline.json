 "linhas": [
  {
   "id": "abre",
   "quem": "narrador",
   "texto": "A cientista que sabe curar os zumbis... ou a última vacina do mundo?",
   "a": 0.12,
   "b": 2.924,
   "w0": 0,
   "w1": 13
  },
  {
   "id": "gancho",
   "quem": "narrador",
   "texto": "Cem toneladas de aço, ladeira abaixo, e o maquinista é você!",
   "a": 3.044,
   "b": 5.967,
   "w0": 13,
   "w1": 24
  },
  {
   "id": "freio1",
   "quem": "narrador",
   "texto": "Você puxa o freio. Travou!",
   "a": 6.427,
   "b": 8.015,
   "w0": 24,
   "w1": 29
  },
  {
   "id": "freio2",
   "quem": "narrador",
   "texto": "Puxa de novo. Nada!",
   "a": 8.135,
   "b": 9.576,
   "w0": 29,
   "w1": 33
  },
  {
   "id": "freio3",
   "quem": "narrador",
   "texto": "Na terceira... a alavanca quebra na sua mão!",
   "a": 10.036,
   "b": 12.187,
   "w0": 33,
   "w1": 41
  },
  {
   "id": "divide",
   "quem": "narrador",
   "texto": "Lá na frente, o trilho se divide. E nenhum dos dois está vazio.",
   "a": 12.647,
   "b": 15.78,
   "w0": 41,
   "w1": 54
  },
  {
   "id": "vacina",
   "quem": "narrador",
   "texto": "No trilho A, uma maleta com a última vacina contra o vírus zumbi. Uma dose só, brilhando azul.",
   "a": 15.9,
   "b": 20.614,
   "w0": 54,
   "w1": 72
  },
  {
   "id": "cidade",
   "quem": "narrador",
   "texto": "Metade da cidade já virou zumbi.",
   "a": 20.734,
   "b": 22.408,
   "w0": 72,
   "w1": 78
  },
  {
   "id": "doutora",
   "quem": "narrador",
   "texto": "No trilho B, a doutora que criou a vacina. Ela correu atrás da maleta, tropeçou, e o jaleco prendeu no trilho.",
   "a": 22.528,
   "b": 27.967,
   "w0": 78,
   "w1": 99
  },
  {
   "id": "socorro",
   "quem": "doutora",
   "texto": "Socorro! Só eu sei fazer outra!",
   "a": 28.247,
   "b": 30.385,
   "w0": 99,
   "w1": 105
  },
  {
   "id": "desvio",
   "quem": "narrador",
   "texto": "Só a alavanca do desvio ainda funciona. Se você não fizer nada, o trem vai pro trilho A.",
   "a": 31.005,
   "b": 35.232,
   "w0": 105,
   "w1": 123
  },
  {
   "id": "braco",
   "quem": "narrador",
   "texto": "Aí o seu braço começa a arder. Você puxa a manga...",
   "a": 35.352,
   "b": 37.788,
   "w0": 123,
   "w1": 134
  },
  {
   "id": "mordida",
   "quem": "narrador",
   "texto": "Uma mordida.",
   "a": 38.538,
   "b": 39.366,
   "w0": 134,
   "w1": 136
  },
  {
   "id": "passageiro",
   "quem": "narrador",
   "texto": "Aquele passageiro do vagão de trás não estava dormindo.",
   "a": 39.486,
   "b": 41.892,
   "w0": 136,
   "w1": 145
  },
  {
   "id": "escolha",
   "quem": "narrador",
   "texto": "A vacina do trilho A é a única que te salva. A doutora do trilho B é a única que salva o mundo.",
   "a": 42.012,
   "b": 46.393,
   "w0": 145,
   "w1": 168
  },
  {
   "id": "pergunta",
   "quem": "narrador",
   "texto": "Trilho A, ou trilho B? Você tem dez segundos!",
   "a": 46.513,
   "b": 49.129,
   "w0": 168,
   "w1": 177
  }
