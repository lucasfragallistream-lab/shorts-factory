 "linhas": [
  {
   "id": "gancho",
   "quem": "narrador",
   "texto": "Cem toneladas de aço, ladeira abaixo, e o maquinista é você!",
   "a": 0.55,
   "b": 3.473,
   "w0": 0,
   "w1": 11
  },
  {
   "id": "velocidade",
   "quem": "narrador",
   "texto": "Oitenta por hora, noventa, cem... e acelerando.",
   "a": 3.593,
   "b": 6.235,
   "w0": 11,
   "w1": 18
  },
  {
   "id": "freio1",
   "quem": "narrador",
   "texto": "Você puxa o freio. Travou!",
   "a": 6.695,
   "b": 8.283,
   "w0": 18,
   "w1": 23
  },
  {
   "id": "freio2",
   "quem": "narrador",
   "texto": "Puxa de novo. Nada!",
   "a": 8.403,
   "b": 9.846,
   "w0": 23,
   "w1": 27
  },
  {
   "id": "freio3",
   "quem": "narrador",
   "texto": "Na terceira... a alavanca quebra na sua mão!",
   "a": 10.306,
   "b": 12.456,
   "w0": 27,
   "w1": 35
  },
  {
   "id": "divide",
   "quem": "narrador",
   "texto": "Lá na frente, o trilho se divide. E nenhum dos dois está vazio.",
   "a": 12.916,
   "b": 16.049,
   "w0": 35,
   "w1": 48
  },
  {
   "id": "pacoca",
   "quem": "narrador",
   "texto": "No trilho A, o Paçoca, seu vira-lata caramelo. Treze anos dormindo no seu pé. Ele te vê, e abana o rabo.",
   "a": 16.169,
   "b": 21.866,
   "w0": 48,
   "w1": 69
  },
  {
   "id": "bilhete",
   "quem": "narrador",
   "texto": "Na coleira, o seu bilhete premiado. Seiscentos milhões de reais.",
   "a": 21.986,
   "b": 25.315,
   "w0": 69,
   "w1": 79
  },
  {
   "id": "vovos",
   "quem": "narrador",
   "texto": "No trilho B, cinco vovôs jogando dominó. Ninguém ouviu o trem: o aparelho de surdez dos cinco está sem pilha.",
   "a": 25.435,
   "b": 30.589,
   "w0": 79,
   "w1": 99
  },
  {
   "id": "bati",
   "quem": "vovo",
   "texto": "Bati! Bati!",
   "a": 30.869,
   "b": 32.681,
   "w0": 99,
   "w1": 101
  },
  {
   "id": "desvio",
   "quem": "narrador",
   "texto": "Só a alavanca do desvio ainda funciona. Se você não fizer nada, o trem vai pro trilho A.",
   "a": 33.301,
   "b": 37.526,
   "w0": 101,
   "w1": 119
  },
  {
   "id": "vira",
   "quem": "narrador",
   "texto": "Aí um vovô vira pra cabine, com um saco de pão. E você conhece esse bigode.",
   "a": 37.646,
   "b": 41.242,
   "w0": 119,
   "w1": 135
  },
  {
   "id": "pai",
   "quem": "narrador",
   "texto": "É o seu pai. O que foi comprar pão há vinte e dois anos.",
   "a": 41.362,
   "b": 43.957,
   "w0": 135,
   "w1": 149
  },
  {
   "id": "oi",
   "quem": "pai",
   "texto": "Oi, filho. Trouxe o pão.",
   "a": 44.707,
   "b": 47.604,
   "w0": 149,
   "w1": 154
  },
  {
   "id": "pergunta",
   "quem": "narrador",
   "texto": "Trilho A, ou trilho B? Você tem dez segundos!",
   "a": 47.884,
   "b": 50.5,
   "w0": 154,
   "w1": 163
  }
 ],
